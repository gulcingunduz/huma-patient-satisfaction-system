# ==============================================================================
# Hüma - Hasta Memnuniyet Sistemi | Ortam Değişkenleri Şablonu
# ==============================================================================
# Kullanım: Bu dosyayı ".env" olarak kopyalayın ve parola alanlarını değiştirin.
#   cp .env.example .env
# Gerçek .env dosyası .gitignore ile repo dışında tutulur.

# Uygulama Profili (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Veritabanı Ayarları
POSTGRES_DB=hbys
POSTGRES_USER=hbys
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
POSTGRES_PORT=5432

# Servis Portları
SERVER_PORT=8080
FRONTEND_PORT=3000

# JPA & Flyway Ayarları (production için validate + true tutulmalıdır)
JPA_DDL_AUTO=validate
FLYWAY_ENABLED=true

# Güvenlik & Oturum Çerezleri (HTTPS reverse proxy arkasında true yapın)
SESSION_COOKIE_SECURE=false
HBYS_RATE_LIMIT_ENABLED=true

# İlk Başlangıç Yönetici (ADMIN) Hesabı
# Uygulama ilk kez açıldığında bu kullanıcı yoksa otomatik oluşturulur.
HBYS_ADMIN_USERNAME=admin
HBYS_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# AI Özetleme Sağlayıcısı (mock | openai)
# Varsayılan "mock" dış API anahtarı olmadan çalışır.
HBYS_AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
